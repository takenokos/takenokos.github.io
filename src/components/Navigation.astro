---
import NavigationLink from "./NavigationLink.astro";
import NavigationCategoriesDropdown from "./preact/NavigationCategoriesDropdown";
const response = await fetch(new URL("/api/categories", Astro.url));
const data = await response.json();
const categories = Array.isArray(data?.data) ? data.data : [];
---

<div
  class="nav-links lg:static lg:inline-flex lg:flex-row flex-col gap-5 py-3 hidden"
>
  <NavigationLink href="/"> Home </NavigationLink>
  <NavigationLink href="/about"> About</NavigationLink>
  <NavigationLink href="/blog"> Blog</NavigationLink>
  <NavigationCategoriesDropdown categories={categories} client:load />
  <!-- <NavigationLink href="/tags"> Tags</NavigationLink> -->
</div>
